# Firebase Project Environment Configuration Template
# Copy this file to .env and fill in your Firebase project credentials

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=calori-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=calori-app
VITE_FIREBASE_STORAGE_BUCKET=calori-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
